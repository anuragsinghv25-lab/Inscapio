{
  "schemaVersion": 1,
  "id": "climate",
  "slug": "climate",
  "kind": "data-story",
  "title": "What will your city feel like in 2070?",
  "shortTitle": "Your city in 2070",
  "language": "en",
  "summary": "Explore how a changing climate could transform the places we know.",
  "theme": "tarn",
  "reading": [
    "deeper"
  ],
  "hero": {
    "title": "What will your city feel like in 2070?",
    "intro": [
      "You can’t picture 2.5 °C. You can picture Madrid in August. Pick a city, drag time forward, and see which place it starts to resemble."
    ],
    "actions": [
      {
        "label": "Begin",
        "targetSectionId": "pattern",
        "emphasis": "primary"
      }
    ]
  },
  "sections": [
    {
      "id": "pattern",
      "title": "A climate is a pattern, not a day.",
      "blocks": [
        {
          "id": "pattern-intro",
          "type": "paragraph",
          "variant": "body",
          "content": [
            {
              "text": "Scientists sort climates with a few questions about a place’s year:"
            }
          ]
        },
        {
          "id": "pattern-questions",
          "type": "fact-row",
          "items": [
            {
              "id": "question-1",
              "title": "How hot?",
              "text": "The warmest month"
            },
            {
              "id": "question-2",
              "title": "How cold?",
              "text": "The coldest month"
            },
            {
              "id": "question-3",
              "title": "How dry?",
              "text": "How much rain, and when"
            }
          ]
        },
        {
          "id": "pattern-label",
          "type": "paragraph",
          "variant": "body",
          "content": [
            {
              "text": "Answer those and a city gets a label. When the answers shift, the label can too, which is why a warming world changes where a city “belongs”."
            }
          ]
        },
        {
          "id": "pattern-koppen",
          "type": "deeper",
          "blocks": [
            {
              "id": "pattern-koppen-note",
              "type": "paragraph",
              "variant": "body",
              "content": [
                {
                  "text": "This follows the idea of the Köppen classification, drawn up in the early 1900s. This demo uses a simplified rule set with one rough dryness flag per city, so labels are approximate."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "explore",
      "title": "Choose a city. Drag time.",
      "blocks": [
        {
          "id": "city-scrubber",
          "type": "scrubber-chart",
          "datasetId": "city-temperatures",
          "groupSelector": {
            "label": "Choose a city",
            "initialGroupId": "london"
          },
          "stepControl": {
            "label": "Year"
          },
          "chart": {
            "title": "Monthly temperature chart",
            "yMin": -12,
            "yMax": 42,
            "yTicks": [
              0,
              10,
              20,
              30,
              40
            ],
            "valueSuffix": "°"
          },
          "legend": {
            "first": [
              {
                "token": "group"
              },
              {
                "text": " today"
              }
            ],
            "now": [
              {
                "token": "group"
              },
              {
                "text": " in "
              },
              {
                "token": "step"
              }
            ],
            "match": [
              {
                "token": "match"
              },
              {
                "text": " today"
              }
            ]
          },
          "headline": {
            "atFirstStep": [
              {
                "token": "group"
              },
              {
                "text": " today. Drag forward to see where its climate is heading."
              }
            ],
            "later": [
              {
                "text": "In "
              },
              {
                "token": "step"
              },
              {
                "text": ", "
              },
              {
                "token": "group"
              },
              {
                "text": " feels most like "
              },
              {
                "token": "match",
                "marks": [
                  "strong"
                ]
              },
              {
                "text": " does today."
              }
            ]
          },
          "stats": [
            {
              "kind": "high",
              "label": "warmest month"
            },
            {
              "kind": "low",
              "label": "coldest month"
            },
            {
              "kind": "category",
              "label": "simplified type",
              "changedFrom": ", changed from"
            }
          ],
          "prediction": {
            "question": [
              {
                "text": "Before you drag: which city’s climate will "
              },
              {
                "token": "group"
              },
              {
                "text": " come closest to by "
              },
              {
                "token": "lastStep"
              },
              {
                "text": "?"
              }
            ],
            "optionsByGroup": {
              "london": [
                "madrid",
                "new-york",
                "singapore"
              ],
              "paris": [
                "madrid",
                "singapore",
                "sao-paulo"
              ],
