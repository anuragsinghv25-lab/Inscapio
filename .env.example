# Names only. NEVER put real values in this file; it is committed.
#
# Local: copy this file to .env.local (untracked, see .gitignore) and fill in the values yourself.
# Vercel: set the same names under Project Settings > Environment Variables, scope = Preview only
#         for staging. Do not set them for Production until the owner decides.
#
# The application does NOT read the Supabase variables yet; they are used from Stage 3.3 on.
# Nobody (including any AI assistant) should ever be sent the values of the secret variables below.

# Optional. Falls back to https://inscapio.in when unset. Leave unset until Stage 3.3 decides previews.
NEXT_PUBLIC_SITE_URL=

# Not secret. Project URL of the STAGING project (Project Settings > API / Connect).
NEXT_PUBLIC_SUPABASE_URL=

# Not secret by design (limited by RLS). The publishable key (starts with sb_publishable_) of the STAGING project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET, SERVER-ONLY. Leave EMPTY in Stage 3.3 staging. Needed only to end a suspended user's sessions
# (Stage 3.4) or if the owner chooses to create invitee accounts from the app (Q-44). It bypasses RLS.
# Never commit it, never put it in a NEXT_PUBLIC_ variable, never paste it into chat.
SUPABASE_SECRET_KEY=

# Deployment secrets for a later CI migration job belong in GitHub Actions secrets, NOT in this file:
#   SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, SUPABASE_PROJECT_ID  (not used until the owner confirms staging is ready)
